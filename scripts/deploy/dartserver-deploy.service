[Unit]
Description=Auto-deploy dartserver (git pull + build + restart)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pstq
WorkingDirectory=/home/pstq/github/cam-stream
# A non-interactive login shell does NOT pick up pnpm/nvm: their PATH exports
# live in ~/.bashrc, which login shells don't source (and which usually returns
# early when non-interactive). Without this, detect_pm falls back to npm, whose
# optional-dependency bug breaks `next build` (@tailwindcss/oxide native binding).
# So set the toolchain PATH explicitly instead of relying on shell rc files.
Environment=PNPM_HOME=/home/pstq/.local/share/pnpm
Environment=PATH=/home/pstq/.local/share/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash -c '/home/pstq/github/cam-stream/scripts/deploy.sh'
# A full web build can take a couple of minutes; don't let systemd kill it.
TimeoutStartSec=900
